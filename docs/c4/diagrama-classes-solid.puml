@startuml Diagrama_Classes_SOLID_World_of_Webcraft
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

title World of Webcraft — Diagrama de Classes (5 Namespaces SOLID)

package "Plano_Central" #FFFDE7 {
  class ServicoEntradaJogo {
    + solicitarEntrada(credenciais): DadosSessao
    + desconectarJogador(idSessao: string): void
  }

  class ServicoAutenticacao {
    + validarCredenciais(login: string, senha: string): TokenJWT
  }

  class AlocadorSalas {
    + selecionarRealmDisponivel(): Realm
    + alocarSalaPrivada(formato: string, jogadores: List): DadosAlocacaoSala
    + criarPartida(): SalaTorneio
  }

  class ContaUsuario {
    - idConta: string
    - email: string
    - hashSenha: string
    - status: StatusConta
    + atualizarPerfil(dados): void
    + alterarStatus(status: StatusConta): void
  }

  enum StatusConta {
    ATIVA
    BLOQUEADA
    SUSPENSA
    ENCERRADA
  }

  class AgregadorCanaisGlobais {
    - canaisGlobais: List
    + processarMensagemGlobal(evento: EventoMensagemGlobal): void
    + publicarMensagemUnificada(evento: EventoMensagemGlobal): void
  }

  class DadosSessao <<DTO>> {
    + playerId: string
    + realmId: string
    + token: TokenJWT
  }

  class TokenJWT <<VO>> {
    + valor: string
    + expiracao: DateTime
    + assinado: boolean
  }

  class DadosAlocacaoSala <<DTO>> {
    + realmId: string
    + roomId: string
    + endpointRealm: string
  }
}

package "Processadores_Eventos" #FFFDE7 {
  class ProcessadorSessaoIniciada {
    - repositorioRealm: IRepositorioRealm
    + processar(evento: EventoDominio): void
    + verificarIdempotencia(idempotencyKey: string): boolean
  }

  class ProcessadorPartidaFinalizada {
    + processar(evento: EventoDominio): void
    + atualizarHistoricoRanking(resumo: ResumoPartida): void
    + verificarIdempotencia(idempotencyKey: string): boolean
  }
}

package "Abstracoes_Interfaces" #FFFDE7 {
  interface IProcessadorEvento {
    + processar(evento: EventoDominio): void
  }

  interface IRepositorioRealm {
    + buscarPorId(realmId: string): Realm
    + listarDisponiveis(): List<Realm>
  }

  interface IProcessadorGameplay {
    + processarInput(playerId: string, comando: Object): void
  }

  interface IPoliticaRetencaoLGPD {
    + aplicarPoliticaRetencao(dados): void
  }

  interface IBarramentoEventos {
    + publicar(topico: string, evento: EventoDominio): void
    + subscrever(topico: string, processador: IProcessadorEvento): void
  }
}

package "Eventos_Dominio" #FFFDE7 {
  abstract class EventoDominio {
    + idEvento: string
    + timestamp: DateTime
    + idempotencyKey: string
  }

  class EventoSessaoIniciada {
    + playerId: string
    + realmId: string
    + sessionToken: string
  }

  class EventoPartidaIniciada {
    + roomId: string
    + realmId: string
  }

  class EventoMensagemGlobal {
    + channelId: string
    + remetenteId: string
    + conteudo: string
  }

  class EventoJogadorDesconectado {
    + playerId: string
    + realmId: string
    + motivo: string
  }

  class EventoPartidaFinalizada {
    + resumo: ResumoPartida
  }

  class ResumoPartida {
    + roomId: string
    + realmId: string
    + duracaoSegundos: int
    + placarFinal: Object
  }
}

package "Shard_Realm" #FFFDE7 {
  class Realm {
    - realmId: string
    - capacidadeMaxima: int = 30000
    + registrarSessao(sessao: SessaoJogador): void
    + obterSala(roomId: string): SalaTorneio
  }

  class SalaTorneio {
    - roomId: string
    - status: StatusPartida
    - jogadores: List<SessaoJogador>
    + iniciarPartida(): void
    + finalizarPartida(): ResumoPartida
  }

  enum StatusPartida {
    AGUARDANDO_JOGADORES
    PRONTA
    EM_ANDAMENTO
    FINALIZADA
    CANCELADA
  }

  class ServidorJogoAutoritativo {
    - tickRateHz: int = 60
    + executarLoopJogo(): void
    + validarProcessarInput(playerId: string, input: Object): void
  }

  class ServicoChatLocal {
    - politicaLGPD: IPoliticaRetencaoLGPD
    + processarMensagem(msg: MensagemChat): void
    + publicarMensagemGlobal(msg: MensagemChat): void
  }

  class MensagemChat {
    + idMensagem: string
    + channelId: string
    + playerId: string
    + conteudo: string
    + timestamp: DateTime
  }

  class SessaoJogador {
    + sessionId: string
    + playerId: string
    + status: StatusSessao
  }

  enum StatusSessao {
    CRIADA
    CONECTADA
    EM_PARTIDA
    DESCONECTADA
  }
}

' Herança de Eventos de Domínio (LSP)
EventoDominio <|-- EventoSessaoIniciada
EventoDominio <|-- EventoPartidaIniciada
EventoDominio <|-- EventoMensagemGlobal
EventoDominio <|-- EventoJogadorDesconectado
EventoDominio <|-- EventoPartidaFinalizada
EventoPartidaFinalizada *-- ResumoPartida
EventoPartidaFinalizada --> EventoPartidaIniciada : referencia

' Implementação de Interfaces (DIP / ISP / OCP)
ProcessadorSessaoIniciada ..|> IProcessadorEvento
ProcessadorPartidaFinalizada ..|> IProcessadorEvento
ServidorJogoAutoritativo ..|> IProcessadorGameplay

' Relações no Plano Central
ServicoEntradaJogo --> ServicoAutenticacao
ServicoEntradaJogo --> AlocadorSalas
ServicoEntradaJogo --> IBarramentoEventos
ServicoEntradaJogo --> DadosSessao
ServicoAutenticacao --> ContaUsuario
ServicoAutenticacao --> TokenJWT
ServicoAutenticacao --> IBarramentoEventos : publica EventoSessaoIniciada
ContaUsuario --> StatusConta
AlocadorSalas --> DadosAlocacaoSala
AlocadorSalas --> IRepositorioRealm
AgregadorCanaisGlobais --> IBarramentoEventos
AgregadorCanaisGlobais --> EventoMensagemGlobal

' Relações dos Processadores
ProcessadorSessaoIniciada --> IRepositorioRealm
ProcessadorSessaoIniciada ..> EventoSessaoIniciada
ProcessadorPartidaFinalizada ..> EventoPartidaFinalizada
ProcessadorPartidaFinalizada ..> ResumoPartida

' Relações de Abstrações
IBarramentoEventos ..> EventoDominio
IBarramentoEventos ..> IProcessadorEvento
IRepositorioRealm ..> Realm

' Relações no Shard do Realm
Realm *-- SessaoJogador
Realm *-- ServicoChatLocal
Realm *-- SalaTorneio
Realm *-- ServidorJogoAutoritativo
SalaTorneio --> StatusPartida
SalaTorneio --> IBarramentoEventos
SalaTorneio ..> ResumoPartida
SalaTorneio --> SessaoJogador
ServicoChatLocal --> MensagemChat
ServicoChatLocal --> IPoliticaRetencaoLGPD
ServicoChatLocal --> IBarramentoEventos : publica mensagens globais
SessaoJogador --> StatusSessao

@enduml
