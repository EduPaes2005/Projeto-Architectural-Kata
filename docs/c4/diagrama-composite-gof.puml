@startuml Padrao_Composite_World_of_Webcraft
skinparam classAttributeIconSize 0

title Padrão Estrutural GoF: Composite — Ações em Lote e Hierarquias (World of Webcraft)

interface EntidadeJogo {
  + aplicarEfeito(efeito: Efeito): void
}

class JogadorLeaf {
  + id: string
  + aplicarEfeito(efeito: Efeito): void
}

class EsquadraoComposite {
  - membros: EntidadeJogo[]
  + adicionar(membro: EntidadeJogo): void
  + aplicarEfeito(efeito: Efeito): void
}

JogadorLeaf ..|> EntidadeJogo : implementa
EsquadraoComposite ..|> EntidadeJogo : implementa
EsquadraoComposite "1" *-- "0..*" EntidadeJogo : compõe

note bottom of EsquadraoComposite
  Propaga aplicarEfeito() recursivamente para jogadores,
  esquadrões e guildas (buffs de área, notificações) e
  unifica a distribuição de permissões em canais de chat hierárquicos.
end note

@enduml
